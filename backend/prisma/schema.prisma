generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URI") 
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   
  createdAt DateTime @default(now())
  profileUri String?
  bio       String?
  githubUri String?
  updatedAt   DateTime  @updatedAt
  projects  Project[]
  collaborations ProjectCollaborator[]
  isEmailVerified Boolean @default(false)
  avatarUri String?
  useAvatar Boolean @default(true)
}
model Project {
  id            String    @id @default(uuid())
  title         String    
  description   String?
  techStack       String[]
  status          String   @default("IN_PROGRESS")
  repositoryUrl String?   
  liveUrl         String?
  // Owner of the project
  userId        String
  owner         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Array of AI chat links/URIs for auto-categorization and analysis
  aiChatUris    String[]  
  architectureLog String?
  
  // Multiple collaborators working on this project
  collaborators ProjectCollaborator[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Junction table for Many-to-Many relationship between Users and Projects (Sharing/Collaboration)
model ProjectCollaborator {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId]) // Ensures a user can't be added twice to the same project
}

model BlackList{
  id              String   @id @default(uuid())
  refreshTokenHash String   @unique
  createdAt DateTime @default(now())

}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime 
}
